#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDI_ICON1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 1
PRODUCTVERSION  1, 0, 0, 1
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Kerorry\0"
            VALUE "FileDescription",  "Power!\0"
            VALUE "FileVersion",      "1.0.0.1\0"
            VALUE "InternalName",     "Power.exe\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Kerorry\0"
            VALUE "OriginalFilename", "Power.exe\0"
            VALUE "ProductName",      "Power\0"
            VALUE "ProductVersion",   "1.0.0.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

// 说明：模板中的按钮坐标只是设计期占位。运行时由 ui.c 的
// UpdateButtonPositions() 按客户区宽度重新计算，资源里的坐标不会生效。
IDD_TOOLBOX DIALOGEX 0, 0, 150, 200
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VSCROLL
CAPTION "Power!"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL "命令提示符",   IDC_CMD,      "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 50,  190, 25
    CONTROL "注册表编辑器", IDC_REGEDIT,  "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 88,  190, 25
    CONTROL "任务管理器",   IDC_TASKMGR,  "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 126, 190, 25
    CONTROL "计算器",       IDC_CALC,     "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 164, 190, 25
    CONTROL "控制面板",     IDC_CONTROL,  "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 202, 190, 25
    CONTROL "记事本",       IDC_NOTEPAD,  "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 240, 190, 25
    CONTROL "资源管理器",   IDC_EXPLORER, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 278, 190, 25
    CONTROL "系统配置",     IDC_MSCONFIG, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 316, 190, 25
END

