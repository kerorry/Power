    IDS_CAPTION_ERROR           "错误"

    IDS_MENU_TITLE              "请选择要使用的权限："
    IDS_MENU_CONTENT            "请根据情况选择。"
    IDS_MENU_BTN_ADMIN          "管理员"
    IDS_MENU_BTN_SYSTEM         "SYSTEM"
    IDS_MENU_BTN_EXIT           "退出"

    IDS_TAB1                    "启动程序"
    IDS_TAB2                    "文件操作"

    IDS_CMD_TEXT                "命令提示符"
    IDS_REGEDIT_TEXT            "注册表编辑器"
    IDS_TASKMGR_TEXT            "任务管理器"
    IDS_CALC_TEXT               "计算器"
    IDS_CONTROL_TEXT            "控制面板"
    IDS_NOTEPAD_TEXT            "记事本"
    IDS_EXPLORER_TEXT           "资源管理器"
    IDS_MSCONFIG_TEXT           "系统配置"
    IDS_CMD_ARGS                "/k title 命令提示符"

    IDS_OWNER_ADMIN             "修改所有者为 Administrators"
    IDS_OWNER_SYSTEM            "修改所有者为 SYSTEM"
    IDS_ADD_PERM_ADMIN          "仅 管理员 完全控制"
    IDS_ADD_PERM_SYSTEM         "仅 SYSTEM 完全控制"
    IDS_FORCE_DELETE            "强制删除"
    IDS_DELETE_ON_REBOOT        "重启后删除"

    IDS_SYSTEM_TOKEN_FAILED     "无法获取系统令牌"
    IDS_IMPERSONATE_FAILED      "模拟用户失败"
    IDS_TAKE_OWNERSHIP_FAILED   "取得对象所有权失败"
    IDS_RESTORE_PRIVILEGE_FAILED "恢复特权失败"
    IDS_CONVERT_SID_FAILED      "转换 SID 失败"

    IDS_OWNER_CHANGED           "所有者已成功更改"
    IDS_OWNER_CHANGE_FAILED     "更改所有者失败"
    IDS_CREATE_DACL_FAILED      "创建 DACL 失败"
    IDS_DACL_REPLACED           "DACL 已成功替换"
    IDS_DACL_REPLACEMENT_FAILED "替换 DACL 失败"
    IDS_DACL_CONFIRM            "此操作是不可逆的权限覆盖，请确认：\n\n目标文件：\n%s\n\n操作后该文件将只有 %s 拥有完全控制，具体影响：\n  1. 现有所有权限条目都会被清除，包括 SYSTEM 和你当前账户的条目\n  2. 与父目录的权限继承关系会被切断，之后父目录权限变化不再影响它\n  3. 除 %s 之外的任何账户都将无法读取、修改或删除该文件，包括你自己\n\n如果目标不是 SYSTEM，误操作后你需要以管理员或 SYSTEM 权限运行本工具才能恢复访问。\n\n确定要继续吗？"
    IDS_DACL_REPLACE_TARGET     "\n将只保留 %s 一条完全控制条目。"
    IDS_DACL_REMOVE_OWNER       "\n当前所有者 %s 的访问也将被移除。"

    IDS_DELETE_NO_TOKEN         "无法以 SYSTEM 令牌执行，操作取消"
    IDS_DELETE_OK               "文件已成功删除"
    IDS_DELETE_FAILED           "删除失败，错误码: %lu"
    IDS_REBOOT_PRIV_FAILED      "无法启用 SeRestorePrivilege，标记失败"
    IDS_REBOOT_OK               "文件已标记为重启后删除"
    IDS_REBOOT_FAILED           "标记失败，错误码: %lu"
    IDS_SID_ADMIN_FAILED        "无法获取 Administrators SID"
    IDS_SID_SYSTEM_FAILED       "无法获取 SYSTEM SID"
END
